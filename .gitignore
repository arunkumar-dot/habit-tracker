# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright — keep e2e/ committed; ignore generated output
/test-results/
/playwright-report/
/blob-report/
/e2e/.auth/

# next.js
/.next/
/out/

# Generated at build time by scripts/generate-sw.mjs (contains baked-in env vars)
/public/firebase-messaging-sw.js

# production
/build

# misc
.DS_Store
*.pem

# Firebase service account keys — contain private keys, never commit
*-firebase-adminsdk-*.json
firebase-adminsdk*.json
serviceAccountKey.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# Claude Code local settings (machine-specific)
.claude/

# Legal reference files — Termly/FreePrivacyPolicy source HTML; not for version control
habitflow-privacy.html
habitflow-terms.html
